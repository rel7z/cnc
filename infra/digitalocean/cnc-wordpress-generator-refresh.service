[Unit]
Description=Refresh CNC WordPress Generator sources
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/opt/cnc/wordpress-generator/paused

[Service]
Type=oneshot
WorkingDirectory=/opt/cnc/wordpress-generator
ExecStart=/usr/bin/python3 /opt/cnc/wordpress-generator/wordpress_bulk.py /opt/cnc/wordpress-generator/candidates.db refresh --reverse-ip-inbox /opt/cnc/wordpress-generator/reverse-ip --commoncrawl-inbox /opt/cnc/wordpress-generator/commoncrawl --pull-commoncrawl
TimeoutStartSec=45min
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/cnc/wordpress-generator
